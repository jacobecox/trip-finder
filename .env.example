# Copy to .env and fill in. Never commit .env.
DATABASE_URL=
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# comma-separated Google accounts that can sign in (family)
ALLOWED_EMAILS=
# subset of ALLOWED_EMAILS who can upload, edit properties/settings and price flights
ADMIN_EMAILS=
ORS_API_KEY=
SERPAPI_API_KEY=
# leave empty locally (PDFs go to .local-storage/)
BLOB_READ_WRITE_TOKEN=
# email import / digest (see email-worker/wrangler.toml); random strings, e.g. openssl rand -base64 32
EMAIL_SECRET=
CRON_SECRET=
# https://trip-finder-email.<your-subdomain>.workers.dev
EMAIL_WORKER_URL=
# public URL used in emails (defaults to the Vercel production domain)
APP_URL=
