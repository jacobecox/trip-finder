# Neon Postgres connection string (use a dev branch locally)
DATABASE_URL=
# Generate with: npx auth secret
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Comma-separated emails allowed to sign in
ALLOWED_EMAILS=
# Vercel Blob token (leave empty locally to use disk storage)
BLOB_READ_WRITE_TOKEN=
# OpenRouteService API key
ORS_API_KEY=
